# Copy to .env.local, fill in your own values, and load it before running any
# of the deployment scripts in validation/.
#
# None of these are committed. They identify objects in one tenant's Fabric
# workspace, and a repo that hardcodes them leaks its own topology into every
# fork and makes the notebooks bind to somebody else's data on import.
#
# PowerShell:
#   Get-Content .env.local | ForEach-Object {
#     if ($_ -match '^\s*([A-Z_]+)\s*=\s*(.+)$') {
#       [Environment]::SetEnvironmentVariable($Matches[1], $Matches[2].Trim())
#     }
#   }
#
# bash:
#   set -a && source .env.local && set +a

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# The workspace holding the lakehouse, notebooks, eventhouse and data agent.
FABRIC_WORKSPACE_ID=00000000-0000-0000-0000-000000000000

# Query URI of the eventhouse, from the KQL database item properties.
FABRIC_KUSTO_URI=https://<cluster>.kusto.fabric.microsoft.com

# The KQL *database* item id, not the eventhouse id. Activator binds to this.
FABRIC_KQL_DATABASE_ID=00000000-0000-0000-0000-000000000000

# Notebook item ids, after deploying agent_eval and agent_remediate.
FABRIC_EVAL_NOTEBOOK_ID=00000000-0000-0000-0000-000000000000
FABRIC_REMEDIATION_NOTEBOOK_ID=00000000-0000-0000-0000-000000000000

# The published data agent the evaluation asks questions of.
FABRIC_DATA_AGENT_ID=00000000-0000-0000-0000-000000000000

# The lakehouse the notebooks attach to for Delta storage.
FABRIC_LAKEHOUSE_ID=00000000-0000-0000-0000-000000000000

# Who gets the regression email. Comma separated.
AGENT_ACCURACY_RECIPIENTS=you@example.com

# Where file_issues.py opens tier 2 issues, as owner/repo.
GITHUB_REPOSITORY=owner/repo

# ---------------------------------------------------------------------------
# Optional. These are demo object names rather than tenant identifiers, so
# they have working defaults and only need setting if you renamed something.
# ---------------------------------------------------------------------------

# FABRIC_KUSTO_DATABASE_NAME=EH_AgentEval
# FABRIC_LAKEHOUSE_NAME=LH_ContosoCoffee
# FABRIC_SEMANTIC_MODEL_NAME=ContosoCoffee
