// Contoso Coffee - DAX measures for the demo semantic model
//
// This file mirrors the 21 measures that exist in the published ContosoCoffee model.
// Table and column names are the model names (Sales, Date, Product, Store with Title
// Case columns), not the lakehouse names (fact_sales, dim_date with snake_case columns).
// The rename happens in the model on purpose: users and AI see the model, not the source.
//
// Every measure has a description. Copilot reads the first 200 characters of a measure
// description, so the business meaning comes first and caveats come last.
// Put them in the Description box in the Properties pane (Model view).
//
// Requires the Date table to be marked as a date table on Date[Date].

// ---------------------------------------------------------------------------
// Core amounts
// ---------------------------------------------------------------------------

// Description: Calculates total sales revenue after discounts, based on the current
// filters such as date, product, store or channel. This is the default revenue measure
// for the model.
Total Net Sales =
SUM ( 'Sales'[Net Amount] )

// Description: Calculates total sales value before any discounts or reductions, in the
// current filter context.
Gross Sales =
SUM ( 'Sales'[Gross Amount] )

// Description: Calculates the total value of discounts granted on sales for the
// currently filtered period, products, stores or channels.
Total Discount =
SUM ( 'Sales'[Discount Amount] )

// Description: Calculates the total cost of goods sold for the sales transactions in the
// current filter context.
Total Cost =
SUM ( 'Sales'[Cost Amount] )

// Description: Calculates the total number of units sold for the filtered set of sales
// rows.
Total Quantity =
SUM ( 'Sales'[Quantity] )

// Description: Counts sales order lines in the filtered data set. Each row in Sales is
// one line, so this is a line count rather than a distinct customer count.
Order Count =
COUNTROWS ( 'Sales' )

// ---------------------------------------------------------------------------
// Margin and rates
// ---------------------------------------------------------------------------

// Description: Calculates profit by subtracting Total Cost from Total Net Sales for the
// current filters. Returns blank when the filtered rows carry no cost of goods sold,
// because reporting revenue with no cost as if it were all profit is wrong.
Gross Margin =
VAR NetSales = [Total Net Sales]
VAR Cost = [Total Cost]
RETURN
    IF ( NOT ISBLANK ( Cost ), NetSales - Cost )

// Description: Shows gross margin as a percentage of Total Net Sales for the current
// filter context. Returns blank rather than 100% when the filtered rows carry no cost
// of goods sold, so missing cost data reads as missing instead of as a perfect margin.
Gross Margin % =
VAR NetSales = [Total Net Sales]
VAR Cost = [Total Cost]
RETURN
    IF ( NOT ISBLANK ( Cost ), DIVIDE ( NetSales - Cost, NetSales ) )

// Description: Shows the share of Gross Sales that was given away as discounts for the
// current filters.
Discount Rate % =
DIVIDE ( [Total Discount], [Gross Sales] )

// ---------------------------------------------------------------------------
// Per sales order line and per unit
// ---------------------------------------------------------------------------

// Description: Calculates the average net sales value per sales order line (Total Net
// Sales divided by Order Count) for the current filters.
Average Order Value =
DIVIDE ( [Total Net Sales], [Order Count] )

// Description: Calculates the average number of units sold per sales order line for the
// current filter context.
Units per Order =
DIVIDE ( [Total Quantity], [Order Count] )

// Description: Calculates the average net revenue per unit sold, dividing Total Net Sales
// by Total Quantity for the current filters. Differs from Average Order Value, which is
// measured per sales order line rather than per unit.
Average Selling Price =
DIVIDE ( [Total Net Sales], [Total Quantity] )

// ---------------------------------------------------------------------------
// Time intelligence
// ---------------------------------------------------------------------------

// Description: Calculates year-to-date Total Net Sales from the start of the calendar
// year up to the last date in the current filter context.
Net Sales YTD =
TOTALYTD ( [Total Net Sales], 'Date'[Date] )

// Description: Calculates quarter-to-date Total Net Sales from the start of the calendar
// quarter up to the last date in the current filter context.
Net Sales QTD =
TOTALQTD ( [Total Net Sales], 'Date'[Date] )

// Description: Returns Total Net Sales for the same period in the previous calendar year,
// aligned to the current date filters.
Net Sales PY =
CALCULATE ( [Total Net Sales], SAMEPERIODLASTYEAR ( 'Date'[Date] ) )

// Description: Shows the year-over-year growth rate of Total Net Sales by comparing the
// current period to the same period last year.
Net Sales YoY % =
DIVIDE ( [Total Net Sales] - [Net Sales PY], [Net Sales PY] )

// Description: Returns Total Net Sales for the previous calendar month, aligned to the
// current date filters. Pair with Net Sales MoM % to show month-over-month trend.
Net Sales PM =
CALCULATE ( [Total Net Sales], PREVIOUSMONTH ( 'Date'[Date] ) )

// Description: Shows the month-over-month growth rate of Total Net Sales by comparing the
// current month to the immediately preceding month.
Net Sales MoM % =
DIVIDE ( [Total Net Sales] - [Net Sales PM], [Net Sales PM] )

// ---------------------------------------------------------------------------
// Store productivity and mix
// ---------------------------------------------------------------------------

// Description: Counts the distinct stores that recorded at least one sale in the current
// filter context. Use as the store denominator for per-store metrics.
Selling Stores =
DISTINCTCOUNT ( 'Sales'[Store Key] )

// Description: Calculates average Total Net Sales per selling store for the current
// filters. Prefer this over Total Net Sales when comparing regions or store types,
// because those groups contain different numbers of stores.
Net Sales per Store =
DIVIDE ( [Total Net Sales], [Selling Stores] )

// Description: Shows each item's share of Total Net Sales relative to all currently
// selected items, respecting slicers and report filters.
% of Total Net Sales =
DIVIDE ( [Total Net Sales], CALCULATE ( [Total Net Sales], ALLSELECTED () ) )
