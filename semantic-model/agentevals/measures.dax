// AgentEvals - DAX measures for the agent accuracy semantic model
//
// GENERATED by validation/build_agentevals_model.py. Do not edit.
//
// Table and column names are the model names, not the SQL names. The
// database still has dbo.runs with a score column; the model calls it
// Evaluation Runs and hides the raw column behind these measures, so
// that nothing can sum a per-run score across runs.
//
// Every measure has a description. Copilot reads the first 200
// characters, so the business meaning comes first. 36 measures.

// -------------------------------------------------------------------------
// Score
// -------------------------------------------------------------------------

// Description: Counts evaluation runs in the current filter context. Use it
// to ask how often the loop has run, not how well it did.
Runs Evaluated =
COUNTROWS ( 'Evaluation Runs' )

// Description: The most recent run time in the current filter context. Every
// 'latest' measure in this model reports the run this points at.
Latest Run Time =
MAX ( 'Evaluation Runs'[Run Time] )

// Description: Scored questions the most recent run answered correctly on
// every attempt. This is the headline accuracy number. Scores belong to one
// run, so this reads the latest rather than adding runs together.
Latest Score =
VAR LatestRun =
    TOPN (
        1,
        'Evaluation Runs',
        'Evaluation Runs'[Run Time], DESC,
        'Evaluation Runs'[Run ID], ASC
    )
RETURN
    SUMX ( LatestRun, 'Evaluation Runs'[Run Score] )

// Description: How many scored questions the most recent run had to answer.
// This is the denominator of the score, and it changes only when the
// question bank changes.
Questions Scored =
VAR LatestRun =
    TOPN (
        1,
        'Evaluation Runs',
        'Evaluation Runs'[Run Time], DESC,
        'Evaluation Runs'[Run ID], ASC
    )
RETURN
    SUMX ( LatestRun, 'Evaluation Runs'[Run Max Score] )

// Description: The most recent score as a percentage of the questions
// available. Use this when comparing runs that used different question
// banks.
Score % =
DIVIDE ( [Latest Score], [Questions Scored] )

// Description: The score of the run immediately before the most recent one.
// Blank on the first ever run.
Previous Score =
VAR LatestRun =
    TOPN (
        1,
        'Evaluation Runs',
        'Evaluation Runs'[Run Time], DESC,
        'Evaluation Runs'[Run ID], ASC
    )
RETURN
    SUMX ( LatestRun, 'Evaluation Runs'[Run Previous Score] )

// Description: Change in score from the previous run to the latest one.
// Negative is a regression and is what the alerting watches for. Blank when
// there is no previous run to compare against.
Score Change =
VAR ThisRun = [Latest Score]
VAR PriorRun = [Previous Score]
RETURN
    IF ( NOT ISBLANK ( PriorRun ), ThisRun - PriorRun )

// Description: The score written the way people say it out loud, such as 13
// / 15. Use it for a card or a sentence rather than for arithmetic.
Score Headline =
FORMAT ( [Latest Score], "0" ) & " / " & FORMAT ( [Questions Scored], "0" )

// Description: Worst alert raised by the most recent run: high, medium or
// none. Only high notifies a person.
Latest Alert Severity =
VAR LatestRun =
    TOPN (
        1,
        'Evaluation Runs',
        'Evaluation Runs'[Run Time], DESC,
        'Evaluation Runs'[Run ID], ASC
    )
RETURN
    MAXX ( LatestRun, 'Evaluation Runs'[Alert Severity] )

// Description: Questions the most recent run answered correctly sometimes
// and wrongly other times. A flake is worse than a steady failure in front
// of an audience, because it cannot be predicted or briefed around.
Flaky Questions =
VAR LatestRun =
    TOPN (
        1,
        'Evaluation Runs',
        'Evaluation Runs'[Run Time], DESC,
        'Evaluation Runs'[Run ID], ASC
    )
RETURN
    SUMX ( LatestRun, 'Evaluation Runs'[Run Flake Count] )

// Description: Questions the most recent run answered wrongly on every
// attempt.
Failing Questions =
VAR LatestRun =
    TOPN (
        1,
        'Evaluation Runs',
        'Evaluation Runs'[Run Time], DESC,
        'Evaluation Runs'[Run ID], ASC
    )
RETURN
    SUMX ( LatestRun, 'Evaluation Runs'[Run Failure Count] )

// Description: Probe questions where the most recent run answered instead of
// refusing. Any value above zero means the model invented something it
// should have declined to say.
Guardrails Lost =
VAR LatestRun =
    TOPN (
        1,
        'Evaluation Runs',
        'Evaluation Runs'[Run Time], DESC,
        'Evaluation Runs'[Run ID], ASC
    )
RETURN
    SUMX ( LatestRun, 'Evaluation Runs'[Run Guardrails Lost Count] )

// Description: Questions where the AI surface itself failed in the most
// recent run. These are infrastructure failures and are excluded from the
// score, so a high value makes the score less trustworthy rather than lower.
Errored Questions =
VAR LatestRun =
    TOPN (
        1,
        'Evaluation Runs',
        'Evaluation Runs'[Run Time], DESC,
        'Evaluation Runs'[Run ID], ASC
    )
RETURN
    SUMX ( LatestRun, 'Evaluation Runs'[Run Errored Count] )

// -------------------------------------------------------------------------
// Answer quality
// -------------------------------------------------------------------------

// Description: Counts individual attempts. Every question is asked several
// times per run, so this is larger than the number of questions.
Attempts =
COUNTROWS ( 'Answers' )

// Description: Attempts graded fully correct. Partly correct does not count.
Correct Attempts =
CALCULATE ( [Attempts], 'Answers'[Grade] = "Correct" )

// Description: Share of attempts graded fully correct. This is a softer
// number than Score %, which only credits a question when every attempt was
// right.
Correct Attempt % =
DIVIDE ( [Correct Attempts], [Attempts] )

// Description: Attempts where the AI surface failed to answer at all. These
// are excluded from grading, because counting an outage as a wrong answer
// turns a healthy model into a false failure.
Errored Attempts =
CALCULATE ( [Attempts], 'Answers'[Grade] = "Errored" )

// Description: How many distinct questions were asked, regardless of how
// many times each was repeated.
Questions Asked =
DISTINCTCOUNT ( 'Answers'[Question ID] )

// Description: Typical time the AI surface took to answer, in seconds.
// Median rather than average, because one timeout would drag an average
// somewhere misleading.
Median Response Time (s) =
DIVIDE ( MEDIANX ( 'Answers', 'Answers'[Response Time (ms)] ), 1000 )

// Description: The slowest single answer, in seconds. Useful for spotting
// the timeouts the median hides.
Slowest Response Time (s) =
DIVIDE ( MAX ( 'Answers'[Response Time (ms)] ), 1000 )

// -------------------------------------------------------------------------
// Defects
// -------------------------------------------------------------------------

// Description: Questions that did not pass cleanly and produced a proposed
// fix. A defect is a proposal, not a change.
Defects Found =
COUNTROWS ( 'Defects' )

// Description: Defects found by the most recent run only. Use this rather
// than Defects Found when asking what is wrong now, because Defects Found
// counts the same recurring problem once per run.
Defects In Latest Run =
VAR LatestRunID =
    MAXX (
        TOPN (
            1,
            'Evaluation Runs',
            'Evaluation Runs'[Run Time], DESC,
            'Evaluation Runs'[Run ID], ASC
        ),
        'Evaluation Runs'[Run ID]
    )
RETURN
    CALCULATE ( [Defects Found], 'Evaluation Runs'[Run ID] = LatestRunID )

// Description: Defects whose proposed fix is safe enough to apply
// automatically. The loop still asks a person first; this only says it could
// not.
Auto Appliable Defects =
CALCULATE ( [Defects Found], 'Defects'[Auto Appliable] = TRUE () )

// -------------------------------------------------------------------------
// Approvals
// -------------------------------------------------------------------------

// Description: Human decisions recorded, approvals and rejections together.
Decisions Made =
COUNTROWS ( 'Approvals' )

// Description: Instructions a person agreed to. An approval authorises a
// change; it is not the change itself.
Approved =
CALCULATE ( [Decisions Made], 'Approvals'[Decision] = "approved" )

// Description: Proposed instructions a person turned down.
Rejected =
CALCULATE ( [Decisions Made], 'Approvals'[Decision] = "rejected" )

// Description: Share of decisions that were approvals. A rate near 100%
// usually means the proposals are being rubber-stamped rather than read.
Approval Rate =
DIVIDE ( [Approved], [Decisions Made] )

// Description: Approvals that have not yet reached the eventhouse that
// triggers the remediation notebook. Anything here older than a few minutes
// means the mirror is not running, so the decision never fired.
Awaiting Mirror =
CALCULATE ( [Approved], ISBLANK ( 'Approvals'[Mirrored Time] ) )

// Description: Approved instructions that have not been written anywhere
// yet. This is the work queue, and it is derived rather than stored so it
// cannot disagree with what actually happened.
Awaiting Apply =
VAR ApprovedDecisions =
    CALCULATETABLE ( 'Approvals', 'Approvals'[Decision] = "approved" )
RETURN
    COUNTROWS (
        FILTER (
            ApprovedDecisions,
            COALESCE (
                CALCULATE (
                    COUNTROWS ( 'Remediations' ),
                    'Remediations'[Persisted] = TRUE ()
                ),
                0
            ) = 0
        )
    )

// -------------------------------------------------------------------------
// Remediation
// -------------------------------------------------------------------------

// Description: Approved instructions that were really written to a semantic
// model or data agent. Rehearsals are excluded.
Remediations Applied =
CALCULATE ( COUNTROWS ( 'Remediations' ), 'Remediations'[Persisted] = TRUE () )

// Description: Applied fixes that a later run re-asked and confirmed. This
// is the only measure in the model that says a fix worked.
Remediations Verified =
CALCULATE (
    COUNTROWS ( 'Remediations' ),
    'Remediations'[Persisted] = TRUE (),
    'Remediations'[Verified] = TRUE ()
)

// Description: Share of applied fixes that a later run proved worked. A low
// value means the loop is changing things without evidence that it helped.
Verified Fix % =
DIVIDE ( [Remediations Verified], [Remediations Applied] )

// -------------------------------------------------------------------------
// Feedback
// -------------------------------------------------------------------------

// Description: Comments left by report readers about an answer.
Feedback Items =
COUNTROWS ( 'Feedback' )

// Description: Feedback saying an answer was wrong or misleading. This is
// evidence a defect may exist, never an approval to change anything.
Negative Feedback =
CALCULATE ( [Feedback Items], 'Feedback'[Verdict] IN { "wrong", "misleading" } )

// Description: Feedback nobody has looked at yet.
Untriaged Feedback =
CALCULATE ( [Feedback Items], 'Feedback'[Triage Status] = "new" )

// -------------------------------------------------------------------------
// Report bindings
// -------------------------------------------------------------------------

// Description: The question currently selected in the approval queue, so the
// approval button can pass it to the user data function. Blank unless
// exactly one question is selected, which stops a decision being recorded
// against an ambiguous selection. This is report plumbing rather than an
// analysis measure.
Selected Question ID =
SELECTEDVALUE ( 'Questions'[Question ID] )

